# Copy to .env and fill in once sandboxes are provisioned. Never commit .env.

PORT=8080

# --- Bloomreach ---
# Loomi Connect (MCP) — remote server URL + SSO auth per the participant kit
BLOOMREACH_LOOMI_CONNECT_URL=
# Engagement Platform API — Project Settings -> Access Management -> API
BLOOMREACH_API_BASE_URL=https://api-engagement.bloomreach.com
BLOOMREACH_PROJECT_TOKEN=
BLOOMREACH_API_TOKEN=
# Hard ID field this project identifies customers by (e.g. "registered", "cookie")
BLOOMREACH_CUSTOMER_ID_FIELD=cookie
# Shared secret to verify inbound webhook calls from the Bloomreach scenario (step 1/3 trigger)
BLOOMREACH_WEBHOOK_SECRET=

# --- Google / Gemini ---
GOOGLE_PROJECT_ID=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-pro-latest

# --- Shopify ---
SHOPIFY_STORE_DOMAIN=your-dev-store.myshopify.com
SHOPIFY_STOREFRONT_API_TOKEN=
SHOPIFY_ADMIN_API_TOKEN=
SHOPIFY_API_VERSION=2026-01
